{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AAE",
  "mainBinaryName": "aae",
  "version": "0.1.0",
  "identifier": "io.github.myspulin24.aae",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AAE – American Airlines Express",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/myspulin24/aae/releases/latest/download/latest.json"
      ],
      "pubkey": "DOPLNIT",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Michal Jašek",
    "copyright": "© 2026 Michal Jašek",
    "category": "StrategyGame",
    "shortDescription": "Letecká manažerská hra pro kamarády",
    "longDescription": "AAE – American Airlines Express: budujte leteckou společnost nad mapou Evropy a soupeřte s kamarády po síti nebo s počítačem.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Czech"],
        "customLanguageFiles": { "Czech": "nsis/Czech.nsh" },
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "AAE"
      }
    }
  }
}
