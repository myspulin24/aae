; Čeština pro instalátor NSIS (převzato ze Stopy).
LangString addOrReinstall ${LANG_CZECH} "Přidat nebo přeinstalovat součásti"
LangString alreadyInstalled ${LANG_CZECH} "Již nainstalováno"
LangString alreadyInstalledLong ${LANG_CZECH} "${PRODUCTNAME} ${VERSION} je již nainstalovaná. Vyberte, co chcete udělat, a pokračujte tlačítkem Další."
LangString appRunning ${LANG_CZECH} "${PRODUCTNAME} je spuštěná. Ukončete ji a zkuste to znovu."
LangString appRunningOkKill ${LANG_CZECH} "${PRODUCTNAME} je spuštěná.$\nKlepnutím na OK ji ukončíte."
LangString chooseMaintenanceOption ${LANG_CZECH} "Vyberte akci údržby."
LangString choowHowToInstall ${LANG_CZECH} "Vyberte, jak chcete aplikaci ${PRODUCTNAME} nainstalovat."
LangString createDesktop ${LANG_CZECH} "Vytvořit zástupce na ploše"
LangString dontUninstall ${LANG_CZECH} "Neodinstalovat"
LangString dontUninstallDowngrade ${LANG_CZECH} "Neodinstalovat (přechod na starší verzi bez odinstalace tento instalátor nepovoluje)"
LangString failedToKillApp ${LANG_CZECH} "Aplikaci ${PRODUCTNAME} se nepodařilo ukončit. Ukončete ji a zkuste to znovu."
LangString installingWebview2 ${LANG_CZECH} "Instaluji WebView2…"
LangString newerVersionInstalled ${LANG_CZECH} "Je nainstalovaná novější verze aplikace ${PRODUCTNAME}. Instalace starší verze se nedoporučuje. Pokud ji opravdu chcete nainstalovat, nejprve odinstalujte současnou verzi. Vyberte, co chcete udělat, a pokračujte tlačítkem Další."
LangString older ${LANG_CZECH} "starší"
LangString olderOrUnknownVersionInstalled ${LANG_CZECH} "V systému je nainstalovaná $R4 verze aplikace ${PRODUCTNAME}. Před instalací doporučujeme současnou verzi odinstalovat. Vyberte, co chcete udělat, a pokračujte tlačítkem Další."
LangString silentDowngrades ${LANG_CZECH} "Tento instalátor nepovoluje přechod na starší verzi, tichou instalaci proto nelze dokončit. Použijte grafický instalátor.$\n"
LangString unableToUninstall ${LANG_CZECH} "Odinstalace se nezdařila."
LangString uninstallApp ${LANG_CZECH} "Odinstalovat ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_CZECH} "Před instalací odinstalovat"
LangString unknown ${LANG_CZECH} "neznámá"
LangString webview2AbortError ${LANG_CZECH} "Instalace WebView2 se nezdařila. Bez něj aplikace nepoběží. Zkuste instalátor spustit znovu."
LangString webview2DownloadError ${LANG_CZECH} "Chyba: stažení WebView2 se nezdařilo – $0"
LangString webview2DownloadSuccess ${LANG_CZECH} "Instalátor WebView2 byl úspěšně stažen"
LangString webview2Downloading ${LANG_CZECH} "Stahuji instalátor WebView2…"
LangString webview2InstallError ${LANG_CZECH} "Chyba: instalace WebView2 skončila s kódem $1"
LangString webview2InstallSuccess ${LANG_CZECH} "WebView2 byl úspěšně nainstalován"
LangString deleteAppData ${LANG_CZECH} "Smazat data aplikace (profil a nastavení; uložené kampaně v Dokumentech zůstanou)"
