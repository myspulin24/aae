{
  "name": "aae",
  "productName": "AAE",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AAE – American Airlines Express, letecká manažerská hra pro kamarády",
  "author": "Michal Jašek",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "tauri dev",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "test:ui": "vitest run",
    "test:rust": "cargo test --workspace --locked",
    "lab": "cargo run --release --locked -p aae-sim --bin lab --",
    "icons": "tauri icon assets/app-icon.svg",
    "package": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
